    "expressions": {
        "conditions": {
            "condition_any_map_on": {
                "name": "Any map visible",
                "value": "$show_bots$ = \"true\" or $show_sales$ = \"true\""
            },
            "condition_both_off": {
                "name": "No map - chart full width",
                "value": "$show_bots$ = \"false\" and $show_sales$ = \"false\""
            },
            "condition_bots_on": {
                "name": "Bot map visible",
                "value": "$show_bots$ = \"true\""
            },
            "condition_sales_on": {
                "name": "Sales map visible",
                "value": "$show_sales$ = \"true\""
            }
        },
        "eval": {
            "expr_bots_label": {
                "name": "botsLabel",
                "value": "$show_bots$ = 'true' ? '🛡️ Hide Bot Map' : '🛡️ Bot Map'"
            },
            "expr_campaign_label": {
                "name": "campaignLabel",
                "value": "$campaign$ = 'product_drop_v2' ? 'Product Drop v2' : ($campaign$ = 'summer_sale_2026' ? 'Summer Sale 2026' : 'Brand Collab Launch')"
            },
            "expr_sales_label": {
                "name": "salesLabel",
                "value": "$show_sales$ = 'true' ? '🗺️ Hide Sales Map' : '🗺️ Sales Map'"
            },
            "expr_toggle_bots": {
                "name": "toggleBots",
                "value": "$show_bots$ = 'true' ? 'false' : 'true'"
            },
            "expr_toggle_sales": {
                "name": "toggleSales",
                "value": "$show_sales$ = 'true' ? 'false' : 'true'"
            }
        }
    }
